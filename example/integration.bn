সংখ্যা ক : 10;
সংখ্যা খ : 5;
সংখ্যা ফলাফল : 0;

স্ট্রিং নাম : "বাংলা কম্পাইলার";

সত্যতা বড় : ক > খ;
সত্যতা ছোট : ক < খ;
সত্যতা সমান : ক == খ;

দেখাও(নাম);
দেখাও(ক + খ);
দেখাও(ক - খ);
দেখাও(ক * খ);
দেখাও(ক / খ);

যদি (বড়)
{
    দেখাও("ক খ এর থেকে বড়");

    যদি (ক > 8)
    {
        দেখাও("ক ৮ এর থেকেও বড়");
    }
    নাহলে
    {
        দেখাও("ক ৮ এর থেকে ছোট");
    }
}
নাহলে
{
    দেখাও("ক খ এর থেকে বড় নয়");
}

যদি (ছোট)
{
    দেখাও("ক ছোট");
}
নাহলে
{
    দেখাও("ক ছোট নয়");

    যদি (সমান)
    {
        দেখাও("ক এবং খ সমান");
    }
    নাহলে
    {
        দেখাও("ক এবং খ সমান নয়");
    }
}

যতক্ষণ (ক > 0)
{
    দেখাও(ক);

    যদি (ক == 5)
    {
        ক : ক - 1;
        চালিয়ে_যাও;
    }

    যদি (ক == 2)
    {
        বিরতি;
    }

    ক : ক - 1;
}

সংখ্যা i : 1;

যতক্ষণ (i < 5)
{
    দেখাও(i);

    যদি (i < 3)
    {
        i : i + 1;
    }
    নাহলে
    {
        i : i + 2;
    }
}
